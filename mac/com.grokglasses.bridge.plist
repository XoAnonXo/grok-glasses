<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.grokglasses.bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PY__</string>
    <string>supervisor.py</string>
  </array>
  <key>WorkingDirectory</key><string>__HERE__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>GROK_SERVER</key><string>https://grok-glasses-server.conscious-carnation.workers.dev</string>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>__HERE__/bridge.log</string>
  <key>StandardErrorPath</key><string>__HERE__/bridge.log</string>
</dict>
</plist>
